<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 500" width="600" height="500">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4a843;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#f0c75e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#b8922e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="navyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0b1d3a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a3a6e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#c0392b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e74c3c;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Crown -->
  <g transform="translate(300, 72)">
    <!-- Crown base -->
    <rect x="-50" y="12" width="100" height="14" rx="3" fill="url(#goldGrad)" />
    <!-- Crown points -->
    <polygon points="-48,12 -38,-18 -25,8" fill="url(#goldGrad)" />
    <polygon points="-22,12 -10,-28 0,2" fill="url(#goldGrad)" />
    <polygon points="-3,12 10,-28 22,12" fill="url(#goldGrad)" />
    <polygon points="25,8 38,-18 48,12" fill="url(#goldGrad)" />
    <!-- Crown jewels -->
    <circle cx="-38" cy="-12" r="3" fill="#e74c3c" />
    <circle cx="0" cy="-22" r="4" fill="#e74c3c" />
    <circle cx="38" cy="-12" r="3" fill="#e74c3c" />
  </g>

  <!-- S Monogram -->
  <g transform="translate(300, 165)">
    <!-- S shape - navy body -->
    <path d="M-8,-60 C-8,-60 45,-58 50,-25 C55,10 15,15 0,15 C-18,15 -55,18 -55,50 C-55,78 -15,85 10,85 C40,85 55,70 55,70" 
          fill="none" stroke="url(#navyGrad)" stroke-width="30" stroke-linecap="round" />
    <!-- Red accent streak -->
    <path d="M-8,-60 C-8,-60 45,-58 50,-25 C55,10 15,15 0,15" 
          fill="none" stroke="url(#redGrad)" stroke-width="10" stroke-linecap="round" opacity="0.7" />
    <!-- Gold swoosh accent -->
    <path d="M-30,85 Q-50,80 -55,60" 
          fill="none" stroke="url(#goldGrad)" stroke-width="4" stroke-linecap="round" opacity="0.8" />
  </g>

  <!-- Airplane -->
  <g transform="translate(370, 105) rotate(35)">
    <path d="M0,0 L-3,-12 L0,-8 L3,-12 Z" fill="#0b1d3a" />
    <path d="M0,-4 L-8,-1 L0,0 L8,-1 Z" fill="#0b1d3a" />
    <path d="M0,0 L-2,5 L0,3 L2,5 Z" fill="#0b1d3a" opacity="0.8" />
  </g>
  <!-- Airplane trail -->
  <path d="M365,110 Q340,100 320,118" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" opacity="0.5" />

  <!-- Mountains -->
  <g transform="translate(300, 215)">
    <polygon points="-60,0 -25,-30 0,0" fill="url(#navyGrad)" />
    <polygon points="-25,-30 -10,-18 0,0" fill="#1a3a6e" opacity="0.6" />
    <polygon points="-10,0 20,-45 50,0" fill="url(#navyGrad)" />
    <polygon points="20,-45 35,-28 50,0" fill="#1a3a6e" opacity="0.6" />
    <polygon points="35,0 55,-20 75,0" fill="url(#navyGrad)" opacity="0.8" />
    <!-- Snow caps -->
    <polygon points="-25,-30 -18,-22 -12,-28" fill="white" opacity="0.3" />
    <polygon points="20,-45 28,-35 32,-40" fill="white" opacity="0.3" />
  </g>

  <!-- Laurel Wreath Left -->
  <g transform="translate(210, 200)" fill="url(#goldGrad)">
    <ellipse cx="0" cy="0" rx="6" ry="14" transform="rotate(-30)" />
    <ellipse cx="-8" cy="18" rx="6" ry="14" transform="rotate(-20)" />
    <ellipse cx="-14" cy="38" rx="6" ry="14" transform="rotate(-10)" />
    <ellipse cx="-16" cy="58" rx="6" ry="13" transform="rotate(0)" />
    <ellipse cx="-14" cy="76" rx="6" ry="12" transform="rotate(10)" />
    <ellipse cx="-8" cy="92" rx="5" ry="11" transform="rotate(20)" />
    <ellipse cx="0" cy="105" rx="5" ry="10" transform="rotate(30)" />
  </g>

  <!-- Laurel Wreath Right -->
  <g transform="translate(390, 200)" fill="url(#goldGrad)">
    <ellipse cx="0" cy="0" rx="6" ry="14" transform="rotate(30)" />
    <ellipse cx="8" cy="18" rx="6" ry="14" transform="rotate(20)" />
    <ellipse cx="14" cy="38" rx="6" ry="14" transform="rotate(10)" />
    <ellipse cx="16" cy="58" rx="6" ry="13" transform="rotate(0)" />
    <ellipse cx="14" cy="76" rx="6" ry="12" transform="rotate(-10)" />
    <ellipse cx="8" cy="92" rx="5" ry="11" transform="rotate(-20)" />
    <ellipse cx="0" cy="105" rx="5" ry="10" transform="rotate(-30)" />
  </g>

  <!-- Main text: SIVARAJ -->
  <text x="300" y="330" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" 
        font-size="68" font-weight="bold" fill="url(#navyGrad)" letter-spacing="8">SIVARAJ</text>
  <!-- Gold outline on text -->
  <text x="300" y="330" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" 
        font-size="68" font-weight="bold" fill="none" stroke="url(#goldGrad)" stroke-width="1" letter-spacing="8" opacity="0.4">SIVARAJ</text>

  <!-- Divider lines -->
  <line x1="120" y1="348" x2="215" y2="348" stroke="url(#goldGrad)" stroke-width="1.5" />
  <line x1="385" y1="348" x2="480" y2="348" stroke="url(#goldGrad)" stroke-width="1.5" />

  <!-- Subtitle: TOUR'S AND TRAVELS -->
  <text x="300" y="368" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" 
        font-size="16" fill="url(#navyGrad)" letter-spacing="6">TOUR'S AND TRAVELS</text>

  <!-- Tagline: Enjoy the Ride -->
  <text x="300" y="400" text-anchor="middle" font-family="'Brush Script MT', 'Segoe Script', cursive" 
        font-size="28" fill="url(#navyGrad)" font-style="italic" opacity="0.7">Enjoy the Ride</text>

  <!-- Location pin -->
  <g transform="translate(300, 425)" fill="url(#navyGrad)" opacity="0.5">
    <path d="M0,-8 C-4.4,-8 -8,-4.4 -8,0 C-8,5.3 0,12 0,12 C0,12 8,5.3 8,0 C8,-4.4 4.4,-8 0,-8 Z" />
    <circle cx="0" cy="0" r="3" fill="url(#goldGrad)" />
  </g>
</svg>