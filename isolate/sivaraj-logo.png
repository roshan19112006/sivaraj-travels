<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 680" width="800" height="680">
  <defs>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c9a84c"/>
      <stop offset="30%" stop-color="#f2d06b"/>
      <stop offset="60%" stop-color="#e6c35a"/>
      <stop offset="100%" stop-color="#b8942e"/>
    </linearGradient>
    <linearGradient id="goldLight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f5e0a0"/>
      <stop offset="100%" stop-color="#c9a84c"/>
    </linearGradient>
    <linearGradient id="navy" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a1a35"/>
      <stop offset="100%" stop-color="#162d52"/>
    </linearGradient>
    <linearGradient id="red" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b82020"/>
      <stop offset="100%" stop-color="#d93030"/>
    </linearGradient>
    <linearGradient id="crownGold" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f7e27c"/>
      <stop offset="40%" stop-color="#daa520"/>
      <stop offset="100%" stop-color="#b8860b"/>
    </linearGradient>
    <filter id="goldGlow">
      <feGaussianBlur stdDeviation="1.5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- ============ CROWN ============ -->
  <g transform="translate(400, 95)" filter="url(#goldGlow)">
    <!-- Crown band -->
    <rect x="-62" y="18" width="124" height="18" rx="3" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.8"/>
    <!-- Crown band highlight -->
    <rect x="-58" y="20" width="116" height="6" rx="2" fill="#f5e6a0" opacity="0.35"/>
    <!-- Left point -->
    <polygon points="-58,18 -46,-22 -32,14" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.5"/>
    <!-- Left-center point (tallest) -->
    <polygon points="-30,18 -14,-40 2,14" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.5"/>
    <!-- Center point -->
    <polygon points="-4,18 10,-44 24,14" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.5"/>
    <!-- Right-center point -->
    <polygon points="22,18 36,-30 50,14" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.5"/>
    <!-- Right point -->
    <polygon points="48,18 56,-18 62,18" fill="url(#crownGold)" stroke="#a07818" stroke-width="0.5"/>
    <!-- Jewels -->
    <circle cx="-46" cy="-16" r="4" fill="#c0392b" stroke="#8b1a1a" stroke-width="0.8"/>
    <circle cx="-14" cy="-34" r="4.5" fill="#c0392b" stroke="#8b1a1a" stroke-width="0.8"/>
    <circle cx="10" cy="-38" r="5" fill="#c0392b" stroke="#8b1a1a" stroke-width="0.8"/>
    <circle cx="36" cy="-24" r="4" fill="#c0392b" stroke="#8b1a1a" stroke-width="0.8"/>
    <!-- Crown base decoration -->
    <circle cx="-48" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
    <circle cx="-28" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
    <circle cx="-8" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
    <circle cx="12" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
    <circle cx="32" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
    <circle cx="52" cy="27" r="2.5" fill="#f5e6a0" opacity="0.6"/>
  </g>

  <!-- ============ S MONOGRAM ============ -->
  <g transform="translate(400, 225)">
    <!-- S - navy body (thick stroke) -->
    <path d="M-10,-75 C-10,-75 60,-72 66,-32 C72,12 18,20 0,20 C-24,20 -72,24 -72,62 C-72,96 -18,105 14,105 C50,105 70,85 70,85" 
          fill="none" stroke="url(#navy)" stroke-width="38" stroke-linecap="round" stroke-linejoin="round"/>
    <!-- S - red accent streak on top curve -->
    <path d="M-10,-75 C-10,-75 60,-72 66,-32 C72,12 18,20 0,20" 
          fill="none" stroke="url(#red)" stroke-width="14" stroke-linecap="round" opacity="0.75"/>
    <!-- Gold swoosh underline -->
    <path d="M-40,105 Q-62,98 -72,78" fill="none" stroke="url(#gold)" stroke-width="5" stroke-linecap="round" opacity="0.7"/>
  </g>

  <!-- ============ AIRPLANE ============ -->
  <g transform="translate(490, 130) rotate(40)">
    <polygon points="0,-16 -4.5,-4 0,-8 4.5,-4" fill="url(#navy)"/>
    <polygon points="0,-5 -12,-1 0,1 12,-1" fill="url(#navy)"/>
    <polygon points="0,1 -3,7 0,5 3,7" fill="url(#navy)" opacity="0.75"/>
  </g>
  <!-- Airplane trail -->
  <path d="M484,138 Q455,125 430,148" fill="none" stroke="url(#gold)" stroke-width="2" opacity="0.45" stroke-dasharray="4,3"/>

  <!-- ============ MOUNTAINS ============ -->
  <g transform="translate(400, 300)">
    <polygon points="-75,0 -30,-40 15,0" fill="url(#navy)"/>
    <polygon points="-30,-40 -10,-22 15,0" fill="#1a3a6e" opacity="0.5"/>
    <polygon points="-12,0 28,-58 68,0" fill="url(#navy)"/>
    <polygon points="28,-58 48,-35 68,0" fill="#1a3a6e" opacity="0.5"/>
    <polygon points="45,0 70,-28 95,0" fill="url(#navy)" opacity="0.8"/>
    <!-- Snow caps -->
    <polygon points="-30,-40 -20,-28 -12,-35" fill="white" opacity="0.35"/>
    <polygon points="28,-58 38,-44 44,-50" fill="white" opacity="0.35"/>
  </g>

  <!-- ============ LAUREL WREATH LEFT ============ -->
  <g transform="translate(295, 175)" fill="url(#gold)" filter="url(#goldGlow)">
    <ellipse cx="0" cy="0" rx="9" ry="20" transform="rotate(-35)"/>
    <ellipse cx="-12" cy="26" rx="9" ry="20" transform="rotate(-25)"/>
    <ellipse cx="-20" cy="55" rx="9" ry="20" transform="rotate(-15)"/>
    <ellipse cx="-24" cy="85" rx="9" ry="19" transform="rotate(-5)"/>
    <ellipse cx="-22" cy="113" rx="8.5" ry="18" transform="rotate(5)"/>
    <ellipse cx="-16" cy="138" rx="8" ry="16" transform="rotate(15)"/>
    <ellipse cx="-6" cy="158" rx="7" ry="14" transform="rotate(25)"/>
    <ellipse cx="6" cy="173" rx="6" ry="12" transform="rotate(35)"/>
    <!-- Stem line -->
    <line x1="6" y1="-5" x2="8" y2="175" stroke="#b8942e" stroke-width="2" opacity="0.4"/>
  </g>

  <!-- ============ LAUREL WREATH RIGHT ============ -->
  <g transform="translate(505, 175)" fill="url(#gold)" filter="url(#goldGlow)">
    <ellipse cx="0" cy="0" rx="9" ry="20" transform="rotate(35)"/>
    <ellipse cx="12" cy="26" rx="9" ry="20" transform="rotate(25)"/>
    <ellipse cx="20" cy="55" rx="9" ry="20" transform="rotate(15)"/>
    <ellipse cx="24" cy="85" rx="9" ry="19" transform="rotate(5)"/>
    <ellipse cx="22" cy="113" rx="8.5" ry="18" transform="rotate(-5)"/>
    <ellipse cx="16" cy="138" rx="8" ry="16" transform="rotate(-15)"/>
    <ellipse cx="6" cy="158" rx="7" ry="14" transform="rotate(-25)"/>
    <ellipse cx="-6" cy="173" rx="6" ry="12" transform="rotate(-35)"/>
    <!-- Stem line -->
    <line x1="-6" y1="-5" x2="-8" y2="175" stroke="#b8942e" stroke-width="2" opacity="0.4"/>
  </g>

  <!-- ============ TEXT: SIVARAJ ============ -->
  <text x="400" y="440" text-anchor="middle"
        font-family="Georgia, 'Palatino Linotype', 'Book Antiqua', serif"
        font-size="90" font-weight="bold" fill="url(#navy)" letter-spacing="10">
    SIVARAJ
  </text>
  <!-- Gold outline accent -->
  <text x="400" y="440" text-anchor="middle"
        font-family="Georgia, 'Palatino Linotype', 'Book Antiqua', serif"
        font-size="90" font-weight="bold" fill="none" stroke="url(#gold)" stroke-width="1.2"
        letter-spacing="10" opacity="0.35">
    SIVARAJ
  </text>

  <!-- ============ DIVIDER LINES ============ -->
  <line x1="145" y1="462" x2="290" y2="462" stroke="url(#gold)" stroke-width="2"/>
  <circle cx="145" cy="462" r="2.5" fill="url(#gold)"/>
  <line x1="510" y1="462" x2="655" y2="462" stroke="url(#gold)" stroke-width="2"/>
  <circle cx="655" cy="462" r="2.5" fill="url(#gold)"/>

  <!-- ============ TEXT: TOUR'S AND TRAVELS ============ -->
  <text x="400" y="490" text-anchor="middle"
        font-family="Georgia, 'Palatino Linotype', 'Book Antiqua', serif"
        font-size="22" fill="url(#navy)" letter-spacing="8">
    TOUR'S AND TRAVELS
  </text>

  <!-- ============ TEXT: Enjoy the Ride ============ -->
  <text x="400" y="535" text-anchor="middle"
        font-family="'Brush Script MT', 'Segoe Script', 'Apple Chancery', cursive"
        font-size="38" fill="url(#navy)" font-style="italic" opacity="0.65">
    Enjoy the Ride
  </text>

  <!-- ============ LOCATION PIN ============ -->
  <g transform="translate(400, 570)" fill="url(#navy)" opacity="0.45">
    <path d="M0,-11 C-6,-11 -10,-7 -10,-2 C-10,4.5 0,14 0,14 C0,14 10,4.5 10,-2 C10,-7 6,-11 0,-11Z"/>
    <circle cx="0" cy="-2" r="4" fill="url(#gold)" opacity="0.8"/>
  </g>
</svg>
